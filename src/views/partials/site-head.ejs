<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="SportsWear: tienda deportiva y panel de administración. Proyecto académico full stack de Marcelo Terrone y Fabricio Quiroga.">
    <title><%= tittle %> | SportsWear</title>
    <link rel="icon" href="/assets/products/fallback.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/css/site.css">
    <% if (currentPath.startsWith('/dashboard')) { %><link rel="stylesheet" href="/css/style.css"><% } %>
    <script src="/js/comun.js" defer></script>
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
        <a class="brand" href="/" aria-label="SportsWear, inicio"><span class="brand-mark" aria-hidden="true">S<span>W</span></span><span>SPORTS<span class="brand-accent">WEAR</span><small>EN MOVIMIENTO.</small></span></a>
        <nav class="header-nav" aria-label="Navegación principal">
            <a href="/tienda" <%- currentPath === '/tienda' ? 'aria-current="page"' : '' %>>Tienda</a>
            <a href="/dashboard" <%- currentPath.startsWith('/dashboard') ? 'aria-current="page"' : '' %>>Administración</a>
            <button class="theme-toggle icon-button" type="button" aria-label="Activar modo oscuro" aria-pressed="false">◐</button>
        </nav>
    </header>
